# Copy this file to .env and fill in your actual values. Never commit the real .env file.

OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
LANGCHAIN_PROJECT="Multi-Document-Assist"
COHERE_API_KEY=your-cohere-api-key-here
OPENAI_API_KEY=sk-your-openai-api-key-here
# optional if you use HuggingFace endpoints
HF_API_KEY=sk-your-huggingface-or-openai-api-key-here
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=langsmith_demo
# Vector DB specialisation credentials
PINECONE_API_KEY=your-pinecone-api-key-here
QDRANT_URL=https://your-qdrant-cluster-url:6333
QDRANT_API_KEY=your-qdrant-api-key-here
