      "roundness": null,
      "seed": 938536777,
      "version": 391,
      "versionNonce": 1337782505,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1780143702532,
      "link": null,
      "locked": false,
      "text": "Query: To check if there are any job\nopenings for DS role\n\n1. LLM (Brain): To plan the action\n2. Orchestrator: It'll be used to execute the\nplan\n3. Tools: It'll help the Agent to interact\nwith real world\n4. Supervisor: Monitor how agents are\nworking \n5. Memory: It'll be used to store\nconversation history to get better context.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Query: To check if there are any job openings for DS role\n\n1. LLM (Brain): To plan the action\n2. Orchestrator: It'll be used to execute the plan\n3. Tools: It'll help the Agent to interact with real world\n4. Supervisor: Monitor how agents are working \n5. Memory: It'll be used to store conversation history to get better context.",
      "autoResize": false,
      "lineHeight": 1.25
    },
