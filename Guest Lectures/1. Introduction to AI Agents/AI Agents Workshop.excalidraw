    {
      "id": "-C3Yfo_ROA_2OS-4nRLS5",
      "type": "text",
      "x": 395.20001220703125,
      "y": 2503.4000091552734,
      "width": 444.79998779296875,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
