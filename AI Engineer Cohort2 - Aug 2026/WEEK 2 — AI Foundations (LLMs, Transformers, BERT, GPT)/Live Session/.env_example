# Example .env file — this is what a .env file looks like.
#
# How to use:
# 1. Copy this file
# 2. Rename the copy to ".env" (no other name works — python-dotenv looks for ".env")
# 3. Replace each placeholder below with your own real key
# 4. Save — never commit or share the real ".env" file (add it to .gitignore)

OPENAI_API_KEY=sk-proj-your-openai-key-here
HF_API_KEY=hf-your-huggingface-key-here
LANGCHAIN_API_KEY=lsv2-your-langchain-key-here
